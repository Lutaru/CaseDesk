# Servidor
PORT=3001
NODE_ENV=development

# Base de Datos Plataforma (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=casedesk_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Autenticación JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Seguridad: Clave Maestra AES-256-GCM para credenciales de clientes (32 bytes hex)
CASEDESK_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Almacenamiento de Evidencias
STORAGE_PATH=D:/CaseDesk/storage/attachments
MAX_FILE_SIZE_MB=50
